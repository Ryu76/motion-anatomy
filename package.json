{
  "name": "motion-anatomy",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "npm --prefix apps/web run test",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "api:test": "cd apps/api && uv run pytest",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build && npm run api:test",
    "verify:release": "npm run verify && npm run test:e2e",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  }
}
