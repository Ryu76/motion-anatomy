# Create a local .env with: cp .env.example .env
# Replace this value before running Docker (for example: openssl rand -hex 24).
POSTGRES_DB=motion_anatomy
POSTGRES_USER=motion
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=15432
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local Alembic example:
# DATABASE_URL=postgresql+psycopg://motion:replace-with-a-random-local-password@localhost:15432/motion_anatomy
